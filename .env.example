# Public site URL, used for canonical URLs, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Lead email delivery via Resend (https://resend.com). If any of these are
# missing, /api/lead logs leads to the server console instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: POST each lead as JSON to a CRM / automation webhook
LEAD_WEBHOOK_URL=

# Analytics: set ONE of these. Loaded only after the visitor accepts the cookie banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Set to "true" locally to preview draft resources (e.g. case studies awaiting approval). Never set in production.
NEXT_PUBLIC_SHOW_DRAFTS=
